{
  "permissions": {
    "allow": [
      "Bash(python3 db/init_db.py)",
      "Bash(python3 scripts/*.py *)",
      "Bash(sqlite3 db/test.db *)",
      "Bash(sleep *)",
      "Read(db/*)",
      "Read(scripts/*)",
      "Read(.claude/*)",
      "Read(CLAUDE.md)",
      "Write(db/test.db)",
      "Write(output/*)",
      "Write(temp/*)",
      "Edit(**)",
      "Glob(**)"
    ]
  },
  "hooks": {
    "PostToolUse": {
      "bash": "python3 scripts/log_usage.py"
    }
  }
}
